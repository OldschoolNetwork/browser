<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp" android:background="@drawable/toolbar">
  <ImageButton android:id="@+id/back" style="@style/ToolbarButton" android:src="@drawable/back" android:contentDescription="Back"/>
  <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:singleLine="true" android:inputType="textUri" android:imeOptions="actionGo" android:textSize="15sp" android:textColor="#222222" android:hint="Search or enter address" android:background="@drawable/address" android:selectAllOnFocus="true"/>
  <Button android:id="@+id/tabs" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginLeft="4dp" android:text="1" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/toolbar_button" android:contentDescription="Tabs"/>
  <ImageButton android:id="@+id/menu" style="@style/ToolbarButton" android:src="@drawable/menu" android:contentDescription="Menu"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:progressDrawable="@drawable/browser_progress" android:visibility="gone"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#FFFFFF" android:background="#735C27" android:visibility="gone"/>
 <FrameLayout android:id="@+id/page" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
